# ---------------------------------------------------------------------------
# SECRETS - ne JAMAIS versionner. Ce depot est un outillage PKI : les
# artefacts produits (cles privees, PFX, mots de passe) restent en local.
# ---------------------------------------------------------------------------
*.key
*.key.pem
*.pem
*.pfx
*.p12
*.jks
*.keystore
*.der
*.crt
*.cer
*.p7b
*.p7c
*.csr
*.meta
*.zip

# Dossiers de travail generes par generate-csr.sh / la GUI (un par FQDN)
Signed/
/certs/
/out/

# Fichiers de notes contenant potentiellement des mots de passe
*password*.txt
*passwd*.txt
*.secret
.env
.env.*
!.env.example

# Un dossier de travail contient des secrets qu'aucune regle d'extension ne
# couvre : notes prises a la main, mots de passe releves, exports divers.
# On exclut donc tout le contenu des dossiers de premier niveau, plutot que de
# compter sur une liste d'extensions qui ne peut pas etre exhaustive.
/*/
!/gui/
!/docs/
!/scripts/

# ---------------------------------------------------------------------------
# Node / Electron
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-electron/
release/
.vite/
*.log
npm-debug.log*

# ---------------------------------------------------------------------------
# OS / editeurs
# ---------------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# ---------------------------------------------------------------------------
# GUI : les icones generees sont versionnees, pas les artefacts de build
# (couverts plus haut par dist/, dist-electron/, release/, node_modules/).
# ---------------------------------------------------------------------------
gui/dist/
gui/dist-electron/
gui/release/

# Binaires OpenSSL embarques : produits par scripts/bundle-openssl.mjs,
# jamais versionnes.
gui/vendor/

# ---------------------------------------------------------------------------
# Tests de bout en bout : rapports, traces et captures sont regeneres a chaque
# execution et n'ont rien a faire dans l'historique.
# ---------------------------------------------------------------------------
gui/test-results/
gui/playwright-report/
gui/blob-report/
gui/.playwright/
