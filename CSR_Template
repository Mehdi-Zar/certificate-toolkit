# Génération de la clé privée RSA
openssl genpkey \
  -algorithm RSA \
  -pkeyopt rsa_keygen_bits:2048 \
  -out www.exemple.fr.pem

chmod 600 www.exemple.fr.pem

# Création de la configuration OpenSSL
cat <<EOF > demande-exemple-req
[ req ]
default_md = sha256
prompt = no
distinguished_name = req_distinguished_name
req_extensions = req_ext

[ req_distinguished_name ]
countryName = FR
organizationName = Ma Societe
organizationalUnitName = SecOps
commonName = www.exemple.fr
emailAddress = pki@exemple.fr

[ req_ext ]
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = www.exemple.fr
EOF

# Génération de la CSR
openssl req \
  -new \
  -key www.exemple.fr.pem \
  -out www.exemple.fr.csr \
  -config demande-exemple-req \
  -extensions req_ext